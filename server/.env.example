# Cấu hình cổng chạy Server
PORT=5000

# Môi trường (development hoặc production)
NODE_ENV=production

# (Tùy chọn) Kết nối MongoDB Atlas (Nếu không điền, hệ thống sẽ tự động dùng file local data/store.json)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/taptakego?retryWrites=true&w=majority

# URL Frontend (dùng khi chạy tách riêng Vite dev server, còn production đã tự bundle)
FRONTEND_URL=http://localhost:5000
